# Copie ce fichier en .env (jamais commité) puis complète.
# Toutes les valeurs ont des défauts prudents : le mode papier marche sans rien remplir.

# --- Mode ---------------------------------------------------------------------
# paper = simulation avec de vrais devis Jupiter, AUCUNE transaction (défaut)
# live  = argent réel : exige aussi LIVE_CONFIRM, RPC_URL et une clé (npm run keygen)
MODE=paper
# LIVE_CONFIRM=je-peux-perdre-ce-budget

# --- Accès --------------------------------------------------------------------
# Facultative mais recommandée (plus de débit) : clé gratuite sur https://developers.jup.ag.
# Vide = accès sans clé, à faible débit. Une clé fausse est refusée par Jupiter.
JUPITER_API_KEY=
# RPC Solana (obligatoire en live), ex. offre gratuite Helius : https://mainnet.helius-rpc.com/?api-key=...
RPC_URL=
# Facultatif : clé RugCheck (le résumé public fonctionne sans)
# RUGCHECK_API_KEY=

# Fichier de clé du wallet DÉDIÉ au bot (hors du dépôt, hors dossiers synchronisés)
KEYPAIR_PATH=~/.solbot/keypair.json
# Données : journal, état, courbe d'equity. Un dossier par mode est recommandé.
DATA_DIR=data/paper

# --- Coffre : les gains au-delà de +SWEEP_TRIGGER_PCT % sont virés ici (adresse publique seulement)
# VAULT_ADDRESS=
SWEEP_TRIGGER_PCT=20

# --- Budget -------------------------------------------------------------------
# Capital virtuel du mode papier, en SOL (mets l'équivalent de ton budget réel)
PAPER_START_SOL=7
# En live, le bot refuse de démarrer si le wallet contient plus que ça (protection contre
# l'erreur « j'ai envoyé tout mon SOL sur le wallet du bot »)
MAX_WALLET_SOL=10

# --- Taille des positions (depuis l'equity, jamais un ticket fixe) -------------
POSITION_PCT=4
MIN_POSITION_SOL=0.05
MAX_POSITION_SOL=0.4
MAX_OPEN_POSITIONS=3
MAX_EXPOSURE_PCT=30
MAX_POOL_SHARE_PCT=1
FEE_RESERVE_SOL=0.05
DRAWDOWN_HALVE_AT_PCT=25

# --- Scanner ------------------------------------------------------------------
MIN_LIQUIDITY_USD=25000
MIN_AGE_MIN=30
MAX_AGE_HOURS=72
MIN_VOL5M_USD=5000
MIN_SPIKE_RATIO=3
MIN_BUYS_5M=20
MIN_BUY_SELL_RATIO=1.2
MIN_PRICE_CHANGE_5M_PCT=0
MAX_PRICE_CHANGE_5M_PCT=30
MIN_MCAP_USD=100000
MAX_MCAP_USD=50000000

# --- Anti-rug -----------------------------------------------------------------
MAX_TOP_HOLDERS_PCT=30
MAX_RUGCHECK_WARNINGS=2
MAX_ROUNDTRIP_COST_PCT=5
ROUNDTRIP_PROBE_SOL=0.3
MIN_ORGANIC_SCORE=30

# --- Sorties ------------------------------------------------------------------
STOP_LOSS_PCT=20
TAKE_PROFIT_PCT=35
TRAIL_ARM_PCT=15
TRAIL_PCT=12
MAX_HOLD_MIN=90
LIQ_DRAIN_EXIT_PCT=40
MAX_ENTRY_IMPACT_BPS=150

# --- Garde-fous ---------------------------------------------------------------
DAILY_LOSS_LIMIT_PCT=10
MAX_CONSECUTIVE_LOSSES=5
PAUSE_AFTER_LOSSES_MIN=360
MAX_TRADES_PER_HOUR=6
HALT_DRAWDOWN_PCT=50
TOKEN_COOLDOWN_HOURS=24

# --- Simulation (mode papier) -------------------------------------------------
PAPER_EXTRA_SLIPPAGE_BPS=150
PAPER_FEE_LAMPORTS=150000
PAPER_RENT_LAMPORTS=2039280

# --- Boucle -------------------------------------------------------------------
SCAN_INTERVAL_SEC=60
EXIT_CHECK_SEC=20

# Programmes supplémentaires autorisés par le pare-feu (après vérification sur solscan.io)
# ALLOWED_PROGRAMS=
