{
  "name": "solbot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de trading Solana prudent : scanner, filtre anti-rug, taille de position sur l'equity, exécution Jupiter avec suivi du slippage, journal des raisons, courbe d'equity. Mode papier par défaut.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "once": "node src/main.ts --once",
    "status": "node src/main.ts --status",
    "doctor": "node scripts/doctor.ts",
    "keygen": "node scripts/keygen.ts",
    "report": "node scripts/report.ts",
    "dashboard": "node scripts/dashboard.ts",
    "reclaim": "node scripts/reclaim.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "desk": "node src/desk/main.ts live",
    "desk:rejeu": "node src/desk/main.ts replay 10",
    "desk:carnet": "node src/desk/main.ts carnet",
    "worker:build": "npx --yes esbuild@0.24.2 worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --minify-whitespace --minify-syntax --legal-comments=none --outfile=worker/dist/worker.js",
    "worker:local": "node worker/local.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
